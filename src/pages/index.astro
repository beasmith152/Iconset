---
import "../styles/icons.css";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Cyber Study Desk</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  </head>

  <body>
    <main class="page">

      <section class="hero">
        <p class="eyebrow">Lucide + GSAP</p>
        <h1>Animated SVG Icon Project</h1>
        <p>Animated SVG icon set built with Astro.</p>
      </section>

      <section class="icon-grid">

        <article class="icon-card book-card">
          <svg class="icon book-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 7v14"/>
            <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>
          </svg>
          <h2>Book Open</h2>
        </article>

        <article class="icon-card pencil-card">
          <svg class="icon pencil-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"/>
            <path d="m15 5 4 4"/>
          </svg>
          <h2>Pencil</h2>
        </article>

        <article class="icon-card cap-card">
          <svg class="icon cap-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/>
            <path d="M22 10v6"/>
            <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>
          </svg>
          <h2>Graduation Cap</h2>
        </article>

        <article class="icon-card notebook-card">
          <svg class="icon notebook-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 6h4"/>
            <path d="M2 10h4"/>
            <path d="M2 14h4"/>
            <path d="M2 18h4"/>
            <rect width="16" height="20" x="4" y="2" rx="2"/>
          </svg>
          <h2>Notebook</h2>
        </article>

        <article class="icon-card brain-card">
          <svg class="icon brain-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/>
            <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/>
          </svg>
          <h2>Brain</h2>
        </article>

      </section>

    </main>

    <script is:inline>
      gsap.from(".icon-card", {
        opacity: 0,
        y: 40,
        stagger: 0.15,
        duration: 0.8
      });

      gsap.to(".book-icon", {
        rotate: -8,
        repeat: -1,
        yoyo: true,
        duration: 1
      });

      gsap.to(".pencil-icon", {
        x: 18,
        rotate: 12,
        repeat: -1,
        yoyo: true,
        duration: 0.7
      });

      gsap.fromTo(".cap-icon",
        { y: -15 },
        {
          y: 8,
          repeat: -1,
          yoyo: true,
          duration: 1
        }
      );

      gsap.to(".notebook-icon", {
        scale: 1.12,
        repeat: -1,
        yoyo: true,
        duration: 0.8
      });

      gsap.to(".brain-icon", {
        scale: 1.08,
        repeat: -1,
        yoyo: true,
        duration: 1
      });
    </script>

  </body>
</html>